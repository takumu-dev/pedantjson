# The reference for pedantjson's public header. Run Doxygen from the repository's root, or build
# the `docs` target. Every public declaration must be documented, and any warning fails the run.

PROJECT_NAME           = pedantjson
PROJECT_BRIEF          = "A strict JSON reader that puts a position on every key and value"

INPUT                  = include
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp
STRIP_FROM_PATH        = include
STRIP_FROM_INC_PATH    = include

JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES

OUTPUT_DIRECTORY       = build/doxygen
GENERATE_HTML          = YES
GENERATE_LATEX         = NO

# No diagrams, so the check needs no Graphviz.
HAVE_DOT               = NO
